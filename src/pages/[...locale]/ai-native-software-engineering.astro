---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SmartImage from '~/components/SmartImage.astro';
import { SITE, type Locale } from '~/config';
import { localizedPath } from '~/i18n/utils';
import { AI_NATIVE_SOFTWARE_ENGINEERING_SERIES, seriesPostPath } from '~/utils/series';

export function getStaticPaths() {
  const series = AI_NATIVE_SOFTWARE_ENGINEERING_SERIES;
  return [
    {
      params: { locale: series.locale === SITE.defaultLocale ? undefined : series.locale },
      props: { locale: series.locale },
    },
  ];
}

const { locale } = Astro.props as { locale: Locale };
const series = AI_NATIVE_SOFTWARE_ENGINEERING_SERIES;
const firstPart = series.parts[0]!;
const firstPartHref = localizedPath(seriesPostPath(firstPart), locale);
const entryPoints = series.entryPoints.map((entry) => ({
  ...entry,
  target: series.parts.find((part) => part.order === entry.part)!,
}));
---

<BaseLayout
  title={series.pageTitle}
  description={series.description}
  ogImage={series.heroImage.src}
  pathWithoutLocale={series.path}
  hidePanel
  crumbs={[{ label: series.title }]}
  availableLocales={[locale]}
>
  <div class="mx-auto w-full max-w-6xl">
    <section
      class="border-base-300 bg-base-100 relative overflow-hidden rounded-2xl border shadow-sm"
      aria-labelledby="series-title"
    >
      <div
        class="from-primary/12 via-base-100 to-secondary/10 absolute inset-0 bg-gradient-to-br"
        aria-hidden="true"
      >
      </div>
      <div class="relative grid items-center gap-8 p-6 sm:p-9 lg:grid-cols-[1.1fr_0.9fr] lg:p-12">
        <div>
          <p
            class="text-primary mb-4 flex items-center gap-2 text-sm font-bold tracking-[0.16em] uppercase"
          >
            <Icon name="lucide:book-open" width={17} height={17} />
            {series.eyebrow}
          </p>
          <h1
            id="series-title"
            class="text-base-content text-4xl leading-[1.08] font-extrabold tracking-tight sm:text-5xl"
          >
            AI-Native Software Engineering
          </h1>
          <p class="text-base-content/80 mt-5 max-w-2xl text-lg leading-relaxed sm:text-xl">
            From faster code generation to a complete engineering operating model: understand what
            changes, what the evidence says, how the workflow works, and what happens when agents
            scale.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a href={firstPartHref} class="btn btn-primary">
              Start with Part 1
              <Icon name="lucide:arrow-right" width={17} height={17} />
            </a>
            <a href="#choose-your-start" class="btn btn-ghost border-base-300 border">
              Choose your starting point
            </a>
          </div>

          <dl class="text-base-content/70 mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <div class="flex items-center gap-2">
              <Icon name="lucide:library-big" width={16} height={16} />
              <dt class="sr-only">Format</dt>
              <dd>5 connected deep dives</dd>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="lucide:route" width={16} height={16} />
              <dt class="sr-only">Journey</dt>
              <dd>Meaning to operating model</dd>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="lucide:users" width={16} height={16} />
              <dt class="sr-only">Audience</dt>
              <dd>Builders, managers, and leaders</dd>
            </div>
          </dl>
        </div>

        <figure class="border-base-300 bg-base-200/70 overflow-hidden rounded-xl border">
          <SmartImage
            src={series.heroImage}
            alt={series.heroImageAlt}
            class="aspect-[16/11] h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            widths={[480, 768, 960, 1200]}
            sizes="(max-width: 1023px) 100vw, 42vw"
            quality={82}
          />
        </figure>
      </div>
    </section>

    <section class="py-14 sm:py-18" aria-labelledby="series-gist">
      <div class="grid gap-9 lg:grid-cols-[0.78fr_1.22fr] lg:gap-14">
        <div>
          <p class="text-primary text-sm font-bold tracking-[0.14em] uppercase">The basic gist</p>
          <h2
            id="series-gist"
            class="text-base-content mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl"
          >
            The series in one minute
          </h2>
          <p class="text-base-content/75 mt-4 text-lg leading-relaxed">
            AI makes implementation cheaper, but it does not make ambiguity, judgment, or
            accountability disappear. It moves the centre of engineering toward defining intent,
            preparing context, controlling execution, and proving that the result is worth keeping.
          </p>
        </div>

        <ol class="space-y-3">
          {
            series.thesis.map((point, index) => (
              <li class="border-base-300 bg-base-100 flex gap-4 rounded-xl border p-4 sm:p-5">
                <span class="bg-primary/12 text-primary flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-extrabold">
                  {index + 1}
                </span>
                <p class="text-base-content/85 leading-relaxed">{point}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="border-base-300 border-y py-11" aria-labelledby="series-map">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-primary text-sm font-bold tracking-[0.14em] uppercase">How it fits</p>
          <h2 id="series-map" class="text-base-content mt-2 text-3xl font-extrabold tracking-tight">
            One argument in five stages
          </h2>
        </div>
        <p class="text-base-content/65 max-w-lg text-sm leading-relaxed">
          Each part answers the question created by the one before it. Read in order for the full
          progression.
        </p>
      </div>

      <ol class="grid gap-3 sm:grid-cols-5">
        {
          series.parts.map((part, index) => (
            <li class="relative">
              <a
                href={localizedPath(seriesPostPath(part), locale)}
                class="group border-base-300 bg-base-100 hover:border-primary/60 flex h-full flex-col rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-sm"
              >
                <span class="text-base-content/45 text-xs font-bold tracking-[0.12em] uppercase">
                  Part {part.order}
                </span>
                <span class="text-base-content group-hover:text-primary mt-2 font-bold transition-colors">
                  {part.stage}
                </span>
                {index < series.parts.length - 1 && (
                  <Icon
                    name="lucide:arrow-right"
                    width={15}
                    height={15}
                    class="text-base-content/30 mt-3 hidden sm:block"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="py-14 sm:py-18" aria-labelledby="reading-path">
      <div class="mx-auto mb-9 max-w-3xl text-center">
        <p class="text-primary text-sm font-bold tracking-[0.14em] uppercase">
          The complete field guide
        </p>
        <h2
          id="reading-path"
          class="text-base-content mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl"
        >
          Read the transformation from first principles
        </h2>
        <p class="text-base-content/70 mt-4 text-lg">
          The recommended route is Part 1 through Part 5. Every article stands alone, but together
          they move from the core idea to the organizational consequences.
        </p>
      </div>

      <ol class="space-y-6">
        {
          series.parts.map((part) => (
            <li>
              <article class="border-base-300 bg-base-100 overflow-hidden rounded-2xl border shadow-sm">
                <div class="grid lg:grid-cols-[0.38fr_0.62fr]">
                  <div class="bg-base-200 min-h-52 overflow-hidden">
                    <SmartImage
                      src={part.heroImage}
                      alt={part.heroImageAlt}
                      class="h-full min-h-52 w-full object-cover"
                      loading="lazy"
                      widths={[420, 640, 820]}
                      sizes="(max-width: 1023px) 100vw, 38vw"
                      quality={76}
                    />
                  </div>

                  <div class="flex flex-col p-6 sm:p-8">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="badge badge-primary badge-outline font-bold">
                        Part {part.order}
                      </span>
                      <span class="badge badge-ghost">{part.stage}</span>
                      {part.order === 3 && (
                        <span class="badge badge-secondary badge-outline">
                          Project manager starting point
                        </span>
                      )}
                    </div>

                    <h3 class="text-base-content mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl">
                      <a
                        href={localizedPath(seriesPostPath(part), locale)}
                        class="hover:text-primary transition-colors"
                      >
                        {part.title}
                      </a>
                    </h3>
                    <p class="text-base-content/75 mt-4 text-base leading-relaxed sm:text-lg">
                      {part.summary}
                    </p>
                    <p class="text-base-content/60 mt-4 flex items-start gap-2 text-sm">
                      <Icon
                        name="lucide:user-round-check"
                        width={16}
                        height={16}
                        class="mt-0.5 shrink-0"
                      />
                      {part.audience}
                    </p>

                    <div class="mt-6">
                      <a
                        href={localizedPath(seriesPostPath(part), locale)}
                        class="text-primary inline-flex items-center gap-2 font-bold hover:underline"
                      >
                        Read Part {part.order}
                        <Icon name="lucide:arrow-right" width={16} height={16} />
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      id="choose-your-start"
      class="border-base-300 bg-base-200/55 scroll-mt-24 rounded-2xl border p-6 sm:p-9"
      aria-labelledby="starting-points"
    >
      <div class="max-w-3xl">
        <p class="text-primary text-sm font-bold tracking-[0.14em] uppercase">
          Already know what you need?
        </p>
        <h2
          id="starting-points"
          class="text-base-content mt-2 text-3xl font-extrabold tracking-tight"
        >
          Start where your work begins
        </h2>
        <p class="text-base-content/70 mt-3 text-lg">
          You can enter at the question closest to your role, then continue forward through the
          remaining parts.
        </p>
      </div>

      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          entryPoints.map((entry) => (
            <li class:list={[entry.part === 3 ? 'md:col-span-2' : '']}>
              <a
                href={localizedPath(seriesPostPath(entry.target), locale)}
                class:list={[
                  'group border-base-300 bg-base-100 hover:border-primary/60 flex h-full gap-4 rounded-xl border p-5 transition hover:-translate-y-0.5 hover:shadow-sm',
                  entry.part === 3 ? 'ring-primary/20 ring-2' : '',
                ]}
              >
                <span class="bg-primary/12 text-primary flex size-10 shrink-0 items-center justify-center rounded-lg">
                  <Icon name={entry.icon} width={20} height={20} />
                </span>
                <span class="min-w-0">
                  <span class="text-base-content group-hover:text-primary flex flex-wrap items-center gap-2 font-bold transition-colors">
                    {entry.title}
                    <span class="text-primary text-xs">Part {entry.part}</span>
                  </span>
                  <span class="text-base-content/65 mt-1 block text-sm leading-relaxed">
                    {entry.description}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="py-14 text-center sm:py-18" aria-labelledby="series-closing">
      <Icon
        name="lucide:route"
        width={34}
        height={34}
        class="text-primary mx-auto"
        aria-hidden="true"
      />
      <h2
        id="series-closing"
        class="text-base-content mx-auto mt-4 max-w-2xl text-3xl font-extrabold tracking-tight"
      >
        Start with the idea. Finish with the operating model.
      </h2>
      <p class="text-base-content/70 mx-auto mt-4 max-w-2xl text-lg">
        The complete journey shows why AI-native engineering is ultimately less about the model than
        the system people build around it.
      </p>
      <a href={firstPartHref} class="btn btn-primary mt-7">
        Begin Part 1
        <Icon name="lucide:arrow-right" width={17} height={17} />
      </a>
    </section>
  </div>
</BaseLayout>
